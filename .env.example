# Local Compose dev secrets (LLD-12 §3). Copy to .env, which is git-ignored.
# These are local-only dev credentials, never used outside local-compose.

POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev
POSTGRES_APP_PASSWORD=app_local_dev

KEYCLOAK_ADMIN_PASSWORD=admin_local_dev

# Keycloak client secrets (LLD-01 §3), applied by keycloak-config-cli.
# These are local-dev-only values; staging uses private_key_jwt (open item).
SF_BFF_CLIENT_SECRET=sf-bff-local-dev-secret
SF_SVC_BFF_CLIENT_SECRET=sf-svc-bff-local-dev-secret
SF_SVC_USERS_CLIENT_SECRET=sf-svc-users-local-dev-secret
SF_SVC_ORGS_CLIENT_SECRET=sf-svc-orgs-local-dev-secret
SF_SVC_AUTHZ_CLIENT_SECRET=sf-svc-authz-local-dev-secret
SF_SVC_SEARCH_CLIENT_SECRET=sf-svc-search-local-dev-secret
SF_SVC_CART_CLIENT_SECRET=sf-svc-cart-local-dev-secret
SF_SVC_ORDERS_CLIENT_SECRET=sf-svc-orders-local-dev-secret
SF_USERS_ADMIN_CLIENT_SECRET=sf-users-admin-local-dev-secret
SF_AUTHZ_ADMIN_CLIENT_SECRET=sf-authz-admin-local-dev-secret

RABBITMQ_DEFAULT_USER=scaleforge
RABBITMQ_DEFAULT_PASS=rabbitmq_local_dev

# Every service's outbox relay / inbox consumer connects with these same
# admin-ish credentials for now (SF_RABBITMQ_USER/PASSWORD). Per-service
# RabbitMQ users/vhosts (LLD-08 §2) are a deliberate, documented deferral
# to a future ADR-0003 revisit, not an oversight (E2.8).
SF_RABBITMQ_USER=scaleforge
SF_RABBITMQ_PASSWORD=rabbitmq_local_dev

# Seeded human test user (LLD-01 §16 E2E login tests only; not a design
# element — real users are JIT-provisioned on first login, never seeded).
E2E_TEST_USER_PASSWORD=e2e-test-local-dev

# mock-payment-provider's webhook signing secret (ADR-0008, LLD-06 §8.2):
# shared out of band between it and payments-svc, not a Keycloak client
# secret (mock-payment-provider is outside the trust boundary and has no
# Keycloak identity of its own). SF_WEBHOOK_SECRETS is a comma-separated
# list on the payments-svc side, supporting a future rotation with both
# an old and new secret active at once; this dev setup only ever has one.
SF_PAYMENTS_WEBHOOK_SECRET=payments-webhook-local-dev-secret

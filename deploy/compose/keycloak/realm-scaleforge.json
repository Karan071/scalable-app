{
  "realm": "scaleforge",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "REGISTER",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD",
    "REVOKE_GRANT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "defaultSignatureAlgorithm": "RS256",
  "attributes": {
    "acr.loa.map": "{\"1\": 1, \"2\": 2}"
  },
  "roles": {
    "realm": [
      {
        "name": "mfa_required",
        "description": "Granted only via the mfa-required group; forces OTP at login (LLD-01 §3.3)."
      }
    ]
  },
  "groups": [
    {
      "name": "mfa-required",
      "realmRoles": [
        "mfa_required"
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "sf-browser",
      "description": "LLD-01 §3.3: SSO cookie, or the forms flow below.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "sf-browser-forms"
        }
      ]
    },
    {
      "alias": "sf-browser-forms",
      "description": "Level of Authentication 1 (acr=1) then 2 (acr=2, step-up only).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "sf-level-1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "sf-level-2"
        }
      ]
    },
    {
      "alias": "sf-level-1",
      "description": "Password, plus login-time MFA when enforced (mfa-required group) or opted into.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "sf-loa-1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "sf-mfa-enforced"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 40,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "sf-mfa-opt-in"
        }
      ]
    },
    {
      "alias": "sf-mfa-enforced",
      "description": "mfa-required group (via role mfa_required): OTP, enrolling first if needed.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "sf-cond-mfa-role"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "sf-mfa-opt-in",
      "description": "Everyone else: OTP only if they configured one (FR-AUTH-05 opt-in).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "sf-cond-not-mfa-role"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "sf-level-2",
      "description": "Step-up (acr_values=2): always a fresh OTP. The only path to acr=2.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "sf-loa-2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "sf-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "sf-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    },
    {
      "alias": "sf-cond-mfa-role",
      "config": {
        "condUserRole": "mfa_required",
        "negate": "false"
      }
    },
    {
      "alias": "sf-cond-not-mfa-role",
      "config": {
        "condUserRole": "mfa_required",
        "negate": "true"
      }
    }
  ],
  "browserFlow": "sf-browser",
  "clientScopes": [
    {
      "name": "users:provision",
      "protocol": "openid-connect",
      "description": "users-svc POST /internal/v1/users:provision (LLD-01 §11.3)"
    },
    {
      "name": "users:read",
      "protocol": "openid-connect",
      "description": "users-svc GET /internal/v1/users:batch (LLD-01 §11.3)"
    },
    {
      "name": "orgs:read",
      "protocol": "openid-connect",
      "description": "orgs-svc GET /internal/v1/memberships/{id} (LLD-03 §8, LLD-02 §7)"
    },
    {
      "name": "catalog:export",
      "protocol": "openid-connect",
      "description": "catalog-svc GET /internal/v1/orgs/{orgId}/products:export, search-svc's reindex job (LLD-05 §9)"
    },
    {
      "name": "catalog:quotes",
      "protocol": "openid-connect",
      "description": "catalog-svc POST /internal/v1/orgs/{orgId}/quotes (LLD-05 §3). Not yet assigned to a client: orders-svc, its only caller, doesn't exist yet."
    },
    {
      "name": "catalog:read_sku",
      "protocol": "openid-connect",
      "description": "catalog-svc GET /internal/v1/orgs/{orgId}/skus/{skuId}, cart-svc's add-to-cart validation (LLD-06 §2)"
    },
    {
      "name": "cart:read",
      "protocol": "openid-connect",
      "description": "cart-svc GET /internal/v1/carts/{cartId}:snapshot (LLD-06 §2). Not yet assigned to a client: orders-svc, its only caller, doesn't exist yet."
    },
    {
      "name": "inventory:reservations:write",
      "protocol": "openid-connect",
      "description": "inventory-svc POST /internal/v1/reservations, :commit, :release (LLD-07 §8). Not yet assigned to a client: orders-svc, its only caller, doesn't exist yet."
    },
    {
      "name": "inventory:reservations:read",
      "protocol": "openid-connect",
      "description": "inventory-svc GET /internal/v1/reservations (LLD-07 §8, R3 reconciliation). Not yet assigned to a client: orders-svc, its only caller, doesn't exist yet."
    }
  ],
  "clients": [
    {
      "clientId": "sf-bff",
      "name": "ScaleForge BFF (browser-facing)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_BFF_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://app.scaleforge.localhost/auth/callback",
        "http://localhost:8020/auth/callback"
      ],
      "webOrigins": [
        "https://app.scaleforge.localhost",
        "http://localhost:8020"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://app.scaleforge.localhost/##http://localhost:8020/",
        "backchannel.logout.url": "https://bff.sf-app.svc/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "scaleforge-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "scaleforge-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "sf_uid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "sf_uid",
            "claim.name": "sf_uid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sf-svc-bff",
      "name": "ScaleForge BFF (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_BFF_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "users:provision",
        "users:read"
      ],
      "protocolMappers": [
        {
          "name": "scaleforge-internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "scaleforge-internal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sf-svc-users",
      "name": "users-svc (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_USERS_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "sf-svc-orgs",
      "name": "orgs-svc (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_ORGS_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "sf-svc-cart",
      "name": "cart-svc (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_CART_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "catalog:read_sku"
      ],
      "protocolMappers": [
        {
          "name": "scaleforge-internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "scaleforge-internal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sf-svc-search",
      "name": "search-svc (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_SEARCH_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "catalog:export"
      ],
      "protocolMappers": [
        {
          "name": "scaleforge-internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "scaleforge-internal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sf-svc-authz",
      "name": "authz-svc (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_AUTHZ_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "orgs:read"
      ],
      "protocolMappers": [
        {
          "name": "scaleforge-internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "scaleforge-internal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sf-users-admin",
      "name": "users-svc Keycloak admin access",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_USERS_ADMIN_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "sf-authz-admin",
      "name": "authz-svc Keycloak admin access (mfa-required group sync)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_AUTHZ_ADMIN_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-sf-users-admin",
      "enabled": true,
      "serviceAccountClientId": "sf-users-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    },
    {
      "username": "service-account-sf-authz-admin",
      "enabled": true,
      "serviceAccountClientId": "sf-authz-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    },
    {
      "username": "e2e-test-user",
      "email": "e2e-test-user@scaleforge.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "E2E",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "$(E2E_TEST_USER_PASSWORD)",
          "temporary": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"sf_uid\", \"displayName\": \"Internal user ID (ADR-0009)\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}

{
  "realm": "scaleforge",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,

  "passwordPolicy": "length(12) and notUsername and notEmail",

  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "REGISTER",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD",
    "REVOKE_GRANT"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,

  "defaultSignatureAlgorithm": "RS256",

  "groups": [{ "name": "mfa-required" }],

  "clientScopes": [
    {
      "name": "users:provision",
      "protocol": "openid-connect",
      "description": "users-svc POST /internal/v1/users:provision (LLD-01 §11.3)"
    },
    {
      "name": "users:read",
      "protocol": "openid-connect",
      "description": "users-svc GET /internal/v1/users:batch (LLD-01 §11.3)"
    }
  ],

  "clients": [
    {
      "clientId": "sf-bff",
      "name": "ScaleForge BFF (browser-facing)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_BFF_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://app.scaleforge.localhost/auth/callback"],
      "webOrigins": ["https://app.scaleforge.localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://app.scaleforge.localhost/",
        "backchannel.logout.url": "https://bff.sf-app.svc/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "scaleforge-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "scaleforge-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "sf_uid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "sf_uid",
            "claim.name": "sf_uid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sf-svc-bff",
      "name": "ScaleForge BFF (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_BFF_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["users:provision", "users:read"],
      "protocolMappers": [
        {
          "name": "scaleforge-internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "scaleforge-internal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sf-svc-users",
      "name": "users-svc (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_USERS_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "sf-svc-orgs",
      "name": "orgs-svc (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_ORGS_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "sf-svc-authz",
      "name": "authz-svc (service identity)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_SVC_AUTHZ_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "sf-users-admin",
      "name": "users-svc Keycloak admin access",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_USERS_ADMIN_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "sf-authz-admin",
      "name": "authz-svc Keycloak admin access (mfa-required group sync)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(SF_AUTHZ_ADMIN_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],

  "users": [
    {
      "username": "service-account-sf-users-admin",
      "enabled": true,
      "serviceAccountClientId": "sf-users-admin",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users"]
      }
    },
    {
      "username": "service-account-sf-authz-admin",
      "enabled": true,
      "serviceAccountClientId": "sf-authz-admin",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users"]
      }
    }
  ]
}
